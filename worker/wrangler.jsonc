{
  "name": "guestimator",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // The app lives at app.theguestimator.com; theguestimator.com is the marketing site
  // (D:\theguestimator-site). workers.dev stays on so older links and builds keep working.
  "routes": [{ "pattern": "app.theguestimator.com", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/p/*", "/sale/*", "/", "/index.html", "/manifest.webmanifest"]
  },
  // Shared with Bottle Tree on purpose: same accounts, same estimate credits, same photos.
  // Guestimator adds only its own ebay_* tables (migrations/0012_ebay.sql).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bottletree",
      "database_id": "c64195f6-148f-4ea5-ba06-90bac6f88290"
    }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "bottletree-photos" }
  ],
  // Its own queue. A queue has one consumer, and bottletree-app consumes bottletree-appraisals;
  // sharing it would run Guestimator's estimates on Bottle Tree's copy of the appraiser.
  "queues": {
    "producers": [{ "binding": "APPRAISALS", "queue": "guestimator-appraisals" }],
    "consumers": [{
      "queue": "guestimator-appraisals",
      "max_batch_size": 1,
      "max_concurrency": 6,
      "max_retries": 2,
      "dead_letter_queue": "guestimator-appraisals-dlq"
    }]
  },
  // eBay sale alerts: read orders for connected sellers (worker.js scheduled()).
  "triggers": { "crons": ["*/15 * * * *"] },
  // Seller alerts (hold requests, sold online) via Cloudflare Email Service. theguestimator.com
  // has to be set up for sending in the dashboard; until then sends fail and are only logged.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "ALERT_FROM": "alerts@theguestimator.com",
    // Accounts allowed to BUY shipping labels. Labels are charged to the Shippo account behind
    // SHIPPO_API_TOKEN (Derek's), so this stays his alone until sellers pay for their own.
    "LABEL_USERS": "dj@soltis.info",
    // Everyone else pays for each label by card (Stripe) before it's bought on the house Shippo
    // account (labelpay.js). Cap = labels/month the Shippo plan allows (free plan: 30); raise it
    // after upgrading. LABEL_FEE_CENTS is Guestimator's own markup per label (card fee is separate).
    "LABEL_PAY": "on",
    // Google redirect sign-in on iPhone/iPad (authorized redirect URI added by Derek 2026-10-05)
    "GOOGLE_REDIRECT": "on",
    "SHIPPO_MONTHLY_CAP": "30",
    "LABEL_FEE_CENTS": "0",
    "NEBIUS_BASE_URL": "https://api.tokenfactory.nebius.com/v1/",
    "TEXT_MODEL": "nvidia/nemotron-3-super-120b-a12b",
    "VISION_MODEL": "google/gemma-3-27b-it",
    "PUBLIC_ORIGIN": "https://app.theguestimator.com",
    "RC_ANDROID_KEY": "goog_bruXXcAjAfxUxeHpcoCYElturCQ",
    "GOOGLE_CLIENT_ID": "751660268260-k999i5tdfr36um4c7uatbu11is4djh9g.apps.googleusercontent.com",
    "RC_WEB_LINK": "https://pay.rev.cat/yebwnpslzqtmxpuq",
    // The RevenueCat webhook that credits purchases still points at bottletree-app, which writes
    // this same D1. Purchases made in Guestimator are therefore credited - by that worker. If
    // bottletree-app is ever retired, move the webhook here and set RC_WEBHOOK_SECRET first.
    "RC_WEBHOOK_ON": "bottletree-app",
    // Must match the endpoint registered with eBay character for character.
    "EBAY_DELETION_URL": "https://app.theguestimator.com/api/ebay/deletion",
    "EBAY_MARKETPLACE": "EBAY_US",
    // Credits one eBay listing costs: "0" (free) or "1".
    "EBAY_LISTING_CREDITS": "1",
    // Platform fee on remote garage-sale purchases, in basis points (300 = 3%).
    "GARAGE_FEE_BPS": "300"
  }
  // Secrets (wrangler secret put): NEBIUS_API_KEY, TAVILY_API_KEY, EBAY_CLIENT_ID,
  // EBAY_CLIENT_SECRET, EBAY_VERIFY_TOKEN, EBAY_RUNAME, EBAY_TOKEN_KEY (32 random bytes, base64).
}
